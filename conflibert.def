Build Definition File
Bootstrap: docker
From: nvidia/cuda:12.6.0-runtime-ubuntu22.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES=compute,utility
    export PATH=/usr/bin:$PATH

%post
    apt-get update && \
    apt-get install -y git && \
    apt-get install -y vim && \

    mkdir -p /app
    git clone https://github.com/Ethan7/ConfliBERT-dockerV2.git /app

    # Create directories for NVIDIA bindings
    mkdir -p /usr/bin
    mkdir -p /usr/lib/x86_64-linux-gnu
    mkdir -p /usr/lib64
    mkdir -p /var/run/nvidia-persistenced

    touch /usr/bin/nvidia-smi
    touch /usr/bin/nvidia-debugdump
    touch /usr/bin/nvidia-persistenced
    touch /usr/bin/nvidia-cuda-mps-control
    touch /usr/bin/nvidia-cuda-mps-server
    touch /etc/localtime

    apt-get install -y python3.10 python3.10-dev python3-pip && \
    ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/pip3 /usr/bin/pip && \
    rm -rf /var/lib/apt/lists/*

    # Upgrade pip and setuptools
    pip3 install --upgrade pip setuptools

    # Install Python dependencies
    pip3 install --no-cache-dir \
        torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124

    pip3 install --no-cache-dir \
        transformers==4.28.1 simpletransformers==0.63.9

%runscript
    exec bash
OK

